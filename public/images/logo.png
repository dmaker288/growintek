<!DOCTYPE html>
<html lang="en-US" prefix="og: https://ogp.me/ns#">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
	<meta name="description" content="Growintek Solutions is an AI-Powered Digital Growth Agency specializing in Web Engineering, Technical SEO, AEO, GEO, Meta &amp; Google Ads, and custom AI lead automation for global enterprises.">
	
	<!-- Performance Preloads & Hints -->
	<link rel="dns-prefetch" href="https://cdn.tailwindcss.com">
	<link rel="preconnect" href="https://cdn.tailwindcss.com" crossorigin="anonymous">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Orbitron:wght@800;900&family=Syne:wght@700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
	<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Orbitron:wght@800;900&family=Syne:wght@700;800&display=swap"></noscript>
	
	<!-- CRITICAL: Instant background paint & inline CSS for 100/100 PageSpeed & 0.000 CLS -->
	<style>
		/* FOUC, Layout Shift & Blue Link Flash Prevention */
		html {
			scroll-behavior: smooth;
			background-color: #000066;
		}
		body {
			background-color: #000066;
			color: #ffffff;
			font-family: 'Inter', system-ui, -apple-system, sans-serif;
			margin: 0;
			padding: 0;
			overflow-x: hidden;
		}
		header {
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			z-index: 50;
			height: 80px;
			min-height: 80px;
		}
		main {
			display: block;
			min-height: 80vh;
		}
		a {
			color: inherit;
			text-decoration: none;
		}
		#mobile-menu-drawer.hidden {
			display: none !important;
		}
		.mega-panel {
			display: none;
		}
		@media screen and (min-width: 1024px) {
			header {
				height: 80px !important;
				min-height: 80px !important;
			}
			header nav,
			header nav div.hidden.lg\:flex,
			header nav .lg\:flex,
			header .hidden.lg\:flex {
				display: flex !important;
				flex-direction: row !important;
				align-items: center !important;
				gap: 1.75rem !important;
			}
			header nav a, header nav span {
				white-space: nowrap !important;
			}
			header .lg\:hidden,
			header button.lg\:hidden {
				display: none !important;
			}
			.group:hover > .mega-panel,
			.group:hover .mega-panel {
				display: block !important;
				visibility: visible !important;
				opacity: 1 !important;
				pointer-events: auto !important;
			}
		}
		/* Global safety net — no element may be wider than viewport */
		* { box-sizing: border-box !important; min-width: 0; }
		section, main, article, aside, header, footer, div {
			max-width: 100%;
		}
		/* Marquee must not contribute to layout width */
		.animate-marquee {
			min-width: max-content;
		}
		/* Marquee parent must clip it */
		.animate-marquee,
		[class*="marquee"] {
			will-change: transform;
		}
		/* Headings — always Syne font, always wrap */
		h1, h2, h3, h4, h5, h6 {
			font-family: 'Syne', sans-serif !important;
			overflow-wrap: break-word !important;
			word-break: break-word !important;
			hyphens: auto;
		}
		/* ===== Blog Carousel item widths — critical: no Tailwind class used ===== */
		.blog-carousel-item {
			width: 100%;
			flex-shrink: 0;
			min-width: 0;
		}
		@media screen and (min-width: 640px) {
			.blog-carousel-item { width: calc(50% - 12px); }
		}
		@media screen and (min-width: 1024px) {
			.blog-carousel-item { width: calc(33.333% - 16px); }
		}
		/* ===== CLS Prevention: Reserve exact heights & paddings before Tailwind loads ===== */
		.pt-32 { padding-top: 8rem !important; }
		.pb-20 { padding-bottom: 5rem !important; }
		.pt-28 { padding-top: 7rem !important; }
		section[aria-label="Hero Section"] {
			min-height: 100vh;
			min-height: 100dvh;
		}
		main {
			display: block !important;
			min-height: 70vh !important;
		}
		/* ===== Touch Targets: All interactive nav elements min 44x44px ===== */
		header nav a, header nav button {
			min-height: 44px;
			min-width: 44px;
			display: inline-flex !important;
			align-items: center;
		}
		/* ===== Page Preloader — hides raw FOUC until Tailwind CDN applies styles ===== */
		#gtk-preloader {
			position: fixed;
			inset: 0;
			z-index: 2147483647;
			background: #000066;
			display: flex;
			align-items: center;
			justify-content: center;
			opacity: 1;
			visibility: visible;
			transition: opacity 0.35s ease, visibility 0.35s ease;
		}
		#gtk-preloader.gtk-done {
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
		}
		.gtk-pre-inner {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 18px;
		}
		.gtk-pre-name {
			color: #BBF340;
			font-size: 1.6rem;
			font-weight: 900;
			letter-spacing: -0.5px;
			font-family: Arial, sans-serif;
		}
		.gtk-pre-ring {
			width: 40px;
			height: 40px;
			border: 3px solid rgba(187,243,64,0.2);
			border-top-color: #BBF340;
			border-radius: 50%;
			animation: gtk-spin 0.7s linear infinite;
		}
		@keyframes gtk-spin { to { transform: rotate(360deg); } }
	</style>
		<script src="https://cdn.tailwindcss.com"></script>
	<script>
		if (typeof tailwind !== 'undefined') {
			tailwind.config = {
				theme: {
					extend: {
						colors: {
							'deep-navy': '#000066',
							'electric-green': '#BBF340',
							'medium-blue': '#0055FF',
						},
						fontFamily: {
							'orbitron': ['Orbitron', 'Syne', 'sans-serif'],
							'syne': ['Syne', 'sans-serif'],
							'inter': ['Inter', 'sans-serif'],
							'mono': ['Space Mono', 'monospace'],
						}
					}
				}
			};
		}
	</script>
	
