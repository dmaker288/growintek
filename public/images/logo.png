<div id="gtk-booking-modal" class="fixed inset-0 bg-[#000033]/80 backdrop-blur-md z-[99999] hidden items-center justify-center p-4">
	<div class="bg-white rounded-3xl max-w-xl w-full p-8 relative shadow-2xl border border-gray-100 animate-fade-in-up">
		<button onclick="gtkCloseBookingModal()" class="absolute top-5 right-5 text-gray-400 hover:text-[#000066] text-2xl font-bold p-2 transition-colors" aria-label="Close booking modal">&times;</button>
		<div class="inline-block px-3 py-1 bg-[#BBF340] text-[#000066] font-bold text-xs rounded-full uppercase tracking-wider mb-3">
			📅 Enterprise Strategy Discovery
		</div>
		<h3 class="font-syne font-extrabold text-2xl md:text-3xl text-[#000066] mb-3">
			Schedule a 1-on-1 Strategy Session
		</h3>
		<p class="text-gray-600 text-sm mb-6 leading-relaxed">
			Book a confidential 30-minute audit call with our growth engineering team. We&rsquo;ll analyze your pipeline, competitive positioning, and ROI targets.
		</p>
		
		<div class="space-y-4 mb-6">
			<a href="https://growintek.com/contact/" class="flex items-center justify-between p-4 bg-[#000066] text-white rounded-2xl hover:bg-[#0055FF] transition-all group shadow-md">
				<div class="flex items-center gap-3">
					<div class="w-10 h-10 rounded-xl bg-[#BBF340] flex items-center justify-center text-[#000066] font-bold">
						<i data-lucide="calendar" class="w-5 h-5"></i>
					</div>
					<div>
						<div class="font-bold text-base">Select Strategy Time Slot</div>
						<div class="text-xs text-gray-300">Book directly on our executive calendar</div>
					</div>
				</div>
				<i data-lucide="arrow-right" class="w-5 h-5 text-[#BBF340] group-hover:translate-x-1 transition-transform"></i>
			</a>
			
			<a href="https://growintek.com/contact/" class="flex items-center justify-between p-4 bg-[#F6F7F8] border border-gray-200 text-[#000066] rounded-2xl hover:border-[#BBF340] hover:bg-white transition-all group">
				<div class="flex items-center gap-3">
					<div class="w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center text-[#0055FF] font-bold">
						<i data-lucide="file-text" class="w-5 h-5"></i>
					</div>
					<div>
						<div class="font-bold text-base">Request Custom Proposal</div>
						<div class="text-xs text-gray-500">Receive a detailed strategy breakdown in 24 hrs</div>
					</div>
				</div>
				<i data-lucide="arrow-right" class="w-5 h-5 text-[#000066] group-hover:translate-x-1 transition-transform"></i>
			</a>
		</div>
		
		<div class="text-center text-xs text-gray-400">
			🔒 Confidential &bull; No long-term commitments &bull; High-ROI focus
		</div>
	</div>
</div>

<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
function gtkOpenBookingModal() {
	var modal = document.getElementById('gtk-booking-modal');
	if (modal) {
		modal.classList.remove('hidden');
		modal.classList.add('flex');
		if (typeof lucide !== 'undefined') { lucide.createIcons(); }
	}
}
function gtkCloseBookingModal() {
	var modal = document.getElementById('gtk-booking-modal');
	if (modal) {
		modal.classList.remove('flex');
		modal.classList.add('hidden');
	}
}
document.addEventListener('keydown', function(e) {
	if (e.key === 'Escape') gtkCloseBookingModal();
});
</script>

