	<script>
		(function() {
			function initLucide() {
				if (typeof lucide !== 'undefined') {
					lucide.createIcons();
				} else {
					setTimeout(initLucide, 50);
				}
			}
			if (document.readyState === 'complete' || document.readyState === 'interactive') {
				initLucide();
			} else {
				document.addEventListener("DOMContentLoaded", initLucide);
			}
		})();
	</script>
