<div id="gtk-preloader" aria-hidden="true" role="presentation">
	<div class="gtk-pre-inner">
		<div class="gtk-pre-name">Growintek</div>
		<div class="gtk-pre-ring"></div>
	</div>
</div>
<script>
(function(){
	var el=document.getElementById('gtk-preloader');
	function hide(){ if(el){ el.classList.add('gtk-done'); setTimeout(function(){ el.style.display='none'; },400); } }
	// Hide after DOMContentLoaded — Tailwind async fires before/around this event
	document.addEventListener('DOMContentLoaded',function(){ setTimeout(hide,250); });
	// Hard fallback: always hide within 3 seconds
	setTimeout(hide,3000);
})();
</script>


<style>
/* Center and stylize mega panels on viewport with a 3D feel */
.mega-panel {
	position: fixed;
	top: 64px; /* matches header height */
	left: 50%;
	transform: translateX(-50%) translateY(12px) scale(0.96);
	z-index: 9999;
	opacity: 0;
	pointer-events: none;
	transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); /* custom 3D bounce/elastic feel */
}
@media (min-width: 1024px) {
	.mega-panel { top: 76px; }
}

/* Hover Bridge pseudo-element to prevent losing focus/hover */
.mega-panel::before {
	content: '';
	position: absolute;
	top: -30px;
	left: 0;
	right: 0;
	height: 32px;
	background: transparent;
}

.mega-trigger:hover .mega-panel,
.mega-panel:hover {
	opacity: 1;
	transform: translateX(-50%) translateY(0) scale(1);
	pointer-events: auto;
}

/* 3D Glassmorphic Container */
.mega-container {
	background: rgba(0, 3, 40, 0.97); /* Premium deep dark slate */
	backdrop-filter: blur(20px);
	-webkit-backdrop-filter: blur(20px);
	border: 1px solid rgba(187, 243, 64, 0.25); /* Subtle lime accent border */
	border-radius: 20px;
	box-shadow: 
		0 30px 60px -15px rgba(0, 0, 0, 0.6), 
		0 0 50px rgba(187, 243, 64, 0.1), /* Lime glow */
		inset 0 1px 1px rgba(255, 255, 255, 0.15);
	padding: 24px;
	margin-top: 8px;
}

/* 3D Glassmorphic Chips */
.mega-chip {
	display: flex;
	align-items: center;
	justify-content: center;
	text-align: center;
	padding: 7px 12px;
	border-radius: 12px;
	font-size: 0.76rem;
	font-weight: 600;
	color: #e5e7eb;
	background: rgba(255, 255, 255, 0.04);
	border: 1px solid rgba(255, 255, 255, 0.07);
	box-shadow: 
		inset 0 1px 0px rgba(255, 255, 255, 0.1),
		0 2px 4px rgba(0, 0, 0, 0.15);
	transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
	white-space: normal;
	word-break: break-word;
	text-decoration: none;
	line-height: 1.35;
	min-height: 38px;
}
.mega-chip:hover {
	background: linear-gradient(135deg, #BBF340 0%, #a2d633 100%);
	color: #000033; /* Pure dark contrast */
	border-color: #BBF340;
	transform: translateY(-2.5px); /* Lift */
	box-shadow: 
		0 10px 24px rgba(187, 243, 64, 0.4), 
		inset 0 1px 0px rgba(255, 255, 255, 0.25);
}
</style>

