# ─────────────────────────────────────────────────────────────
# GrowinTek — environment
# Copy to .env, fill in, never commit .env
# ─────────────────────────────────────────────────────────────

# Prisma Postgres (console.prisma.io → create project → copy the pooled URL)
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=REPLACE_ME"

# Public site URL, no trailing slash
NEXT_PUBLIC_SITE_URL="https://growintek.com"

# 32+ random characters. Generate: openssl rand -base64 48
AUTH_SECRET="REPLACE_WITH_LONG_RANDOM_STRING"

# Who can sign in to /admin. Comma-separated.
ADMIN_EMAILS="dmaker288@gmail.com"

# Email delivery for magic-link sign-in and lead notifications (optional in dev)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="GrowinTek <hello@growintek.com>"

# Media storage. Leave blank to use the local-disk driver (data/uploads).
# Set MEDIA_DRIVER=s3 with an S3-compatible bucket for production.
MEDIA_DRIVER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ── Reviews ──────────────────────────────────────────────────
# Google Business Profile: requires OAuth (Google Cloud project, Business
# Profile API enabled) plus an approved GBP API quota. See docs/CMS.md.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GBP_ACCOUNT_ID=""
GBP_LOCATION_ID=""

# Trustpilot: Business Units API key from your Trustpilot business account.
TRUSTPILOT_API_KEY=""
TRUSTPILOT_BUSINESS_UNIT_ID=""

# Facebook Page: long-lived page access token (pages_read_engagement scope).
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_TOKEN=""

# ── Social feeds ─────────────────────────────────────────────
# Instagram Graph API (business/creator account linked to the FB page).
INSTAGRAM_BUSINESS_ACCOUNT_ID=""

# YouTube Data API v3 key (Google Cloud → APIs & Services → Credentials).
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""

# ── Analytics ────────────────────────────────────────────────
# Salt for hashing visitor IPs before storage. Change once, then never.
ANALYTICS_SALT="REPLACE_WITH_LONG_RANDOM_STRING"

# Optional: real Google Analytics 4 measurement id, loaded only after consent.
NEXT_PUBLIC_GA4_ID=""

# Bearer token for the scheduled review/feed sync (/api/cron/sync).
CRON_SECRET="REPLACE_WITH_LONG_RANDOM_STRING"
