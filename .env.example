# Copy to .env on the SERVER. Never use VITE_ prefixes for credentials.
PORT=3000
DATABASE_PATH=data/growintek.sqlite
MEDIA_PATH=data/media
# Required for production. Exact HTTPS origin, without a trailing slash.
SITE_URL=
# Set only when behind this exact number of trusted proxy hops.
TRUST_PROXY_HOPS=0

# DashScope: use the key and endpoint from the SAME region/workspace.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=qwen3.5-flash
# Example base URL:
# https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# Google service account; enable Search Console and Analytics Data APIs.
GOOGLE_CLIENT_EMAIL=
# Quoted PEM value with literal \n escapes; never commit it.
GOOGLE_PRIVATE_KEY=
GSC_PROPERTY=
# Examples: sc-domain:your-domain.com or https://your-domain.com/
GA4_PROPERTY_ID=
GOOGLE_SITE_VERIFICATION=
# GA measurement ID is set in Admin > Site settings, not a secret.

# IndexNow key: 8–128 letters, digits or hyphens. Serves /KEY.txt automatically.
INDEXNOW_KEY=

# Meta professional accounts and approved read permissions.
META_GRAPH_VERSION=v24.0
META_PAGE_ID=
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# YouTube Data API v3, restricted server-side key and channel ID.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Vercel + Prisma Postgres. Leave DATABASE_URL blank for local SQLite.
# Prisma Console > Database > Connect: pooled PostgreSQL connection.
DATABASE_URL=
# Direct or session-pooler connection for migrations (not a browser URL).
DIRECT_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=growintek-media
# Random 32+ character secret. Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# Composio project key and the connected account IDs from THAT project.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
COMPOSIO_FACEBOOK_ACCOUNT_ID=
COMPOSIO_INSTAGRAM_ACCOUNT_ID=
COMPOSIO_YOUTUBE_ACCOUNT_ID=
COMPOSIO_TOOL_VERSION=latest
# Optional persistent-host event listener; keep false on Vercel.
COMPOSIO_STREAM_ENABLED=false
COMPOSIO_YOUTUBE_TRIGGER_ID=

# S3-compatible private image storage (preferred over database/Supabase storage).
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
# Composio webhook subscription signing secret; not its API key.
COMPOSIO_WEBHOOK_SECRET=
# Google Business Profile owner OAuth, after Google project approval.
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
