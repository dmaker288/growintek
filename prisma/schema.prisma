generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model Document {
  id String @id
  kind String
  slug String
  data String @db.Text
  revision Int @default(1)
  created_at String
  updated_at String
  @@unique([kind, slug])
  @@index([kind, updated_at])
  @@map("documents")
}
model Setting {
  id Int @id
  data String @db.Text
  revision Int @default(1)
  @@map("settings")
}
model Admin {
  id String @id
  email String @unique
  password_hash String
  created_at String
  sessions Session[]
  @@map("admins")
}
model Session {
  token_hash String @id
  admin_id String
  csrf String
  expires_at BigInt
  admin Admin @relation(fields:[admin_id],references:[id],onDelete:Cascade)
  @@index([admin_id])
  @@index([expires_at])
  @@map("sessions")
}
model Job {
  id String @id
  kind String
  status String
  data String @db.Text
  attempts Int @default(0)
  available_at BigInt
  lease_until BigInt?
  error String?
  created_at String
  updated_at String
  @@index([status,available_at])
  @@map("jobs")
}
model Event {
  id Int @id @default(autoincrement())
  path String
  event String
  day String
  @@index([day,event])
  @@map("events")
}
model AuditLog {
  id Int @id @default(autoincrement())
  actor String
  action String
  target String
  created_at String
  @@map("audit_log")
}
model SchemaMigration {
  version String @id
  @@map("schema_migrations")
}
model RateLimit {
 id String @id
 hits Int
 reset_at BigInt
 @@index([reset_at])
 @@map("rate_limits")
}

model MediaAsset {
  filename String @id
  data String @db.Text
  created_at String
  @@index([created_at])
  @@map("media_assets")
}
