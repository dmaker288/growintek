{
  "name": "growintek",
  "version": "1.0.0",
  "private": true,
  "description": "GrowinTek — websites, AI agents and automation for growing businesses. Next.js site + agency CMS, invoicing and analytics.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.675.0",
    "@prisma/client": "6.16.1",
    "next": "15.5.4",
    "nodemailer": "7.0.6",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/nodemailer": "6.4.17",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "prisma": "6.16.1",
    "tsx": "4.20.3",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
