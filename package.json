{
  "name": "growintek",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "build": "prisma generate && tsc -b && vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "start": "NODE_ENV=production node server/index.js",
    "preview": "SERVE_BUILD=true node server/index.js",
    "test": "node --test tests/*.test.js",
    "admin:create": "node scripts/admin.js",
    "worker": "node scripts/worker.js",
    "backup": "node scripts/backup.js",
    "format": "prettier --write src server tests/*.js",
    "test:browser:setup": "node scripts/browser-test-setup.js",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:import": "node scripts/import-sqlite.js",
    "postinstall": "prisma generate",
    "admin:local": "node scripts/local-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}
